# Token bot Telegram dari @BotFather. Jangan pernah commit nilai aslinya.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# String acak panjang. Dipakai Telegram untuk membuktikan request webhook asli.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_bytes

# --- Akses pengguna ---
# Pilih salah satu kebijakan:
# 1. TELEGRAM_ALLOWED_IDS diisi  -> hanya ID di daftar ini yang dilayani.
# 2. TELEGRAM_PUBLIC=true        -> semua orang boleh chat (tetap ada rate limit).
# 3. TELEGRAM_OWNER_ID diisi     -> hanya owner yang dilayani (mode lama).
# 4. Tidak ada yang diisi        -> mode setup, hanya /start dan /id.
TELEGRAM_ALLOWED_IDS=123456789,987654321
TELEGRAM_OWNER_ID=
TELEGRAM_PUBLIC=false

# --- AI ---
# API key Google AI Studio. Simpan hanya di Environment Variables Vercel.
GEMINI_API_KEY=replace_me

# ID model Gemini yang dipakai. Produksi saat ini memakai gemini-3.5-flash
# karena lebih cepat daripada gemini-3.1-flash-lite pada pengukuran terakhir.
GEMINI_MODEL=gemini-3.5-flash

# --- Karakter ---
# Nama default karakter. Bisa diganti per user lewat /setname.
CHARACTER_NAME=Ayu

# Preset default: extra_clingy, sweet, atau playful.
DEFAULT_PRESET=sweet

# Opsional: override total system prompt. Placeholder yang didukung:
# {{name}}, {{user}}, {{memory}}, {{summary}}, {{now}}.
# BOT_PERSONA=Kamu adalah ...

# --- Penyimpanan memori (wajib untuk produksi multi-user) ---
# Upstash Redis REST. Tanpa ini, memori hanya hidup di dalam satu instance
# serverless dan akan hilang saat function di-restart.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Alternatif kalau memakai Vercel KV:
# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=replace_me

# Opsional: dipakai scripts/set-webhook.mjs kalau URL tidak dikirim sebagai argumen.
PUBLIC_BASE_URL=https://your-project.vercel.app
