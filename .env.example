# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Long random string. Used by Telegram to prove the webhook request is genuine.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_bytes

# Your personal Telegram numeric user ID. The bot only replies to this account.
# Send /id to the deployed bot once to discover it, or use @userinfobot.
TELEGRAM_OWNER_ID=123456789

# Google AI Studio API key. Keep it in Vercel Environment Variables only.
GEMINI_API_KEY=replace_me

# Exact Gemini model ID. Change only if Google renames the model.
GEMINI_MODEL=gemini-3.1-flash

# Optional: override the default Indonesian persona.
# BOT_PERSONA=Kamu adalah ...

# Optional: used by scripts/set-webhook.mjs if you do not pass the URL as an argument.
PUBLIC_BASE_URL=https://your-project.vercel.app
