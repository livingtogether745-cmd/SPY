# Token bot Telegram dari @BotFather. Jangan pernah commit nilai aslinya.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# String acak panjang. Dipakai Telegram untuk membuktikan request webhook asli.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_bytes

# ID numerik Telegram kamu. Bot hanya membalas akun ini.
# Kirim /id ke bot yang sudah deploy untuk melihatnya, atau pakai @userinfobot.
TELEGRAM_OWNER_ID=123456789

# API key Google AI Studio. Simpan hanya di Environment Variables Vercel.
GEMINI_API_KEY=replace_me

# ID model Gemini yang dipakai. Ubah hanya kalau Google mengganti nama model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Opsional: override persona Indonesia default.
# BOT_PERSONA=Kamu adalah ...

# Opsional: dipakai scripts/set-webhook.mjs kalau URL tidak dikirim sebagai argumen.
PUBLIC_BASE_URL=https://your-project.vercel.app
